# ==============================================================================
# NIRA Ambient Care — Environment Configuration Template
# Amazon Developer Hackathon 2026
#
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Configuration
# ------------------------------------------------------------------------------
# Your MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nira_db

# Local SQLite Mirror / Fallback
DATABASE_URL=sqlite:///./aegis_care.db

# ------------------------------------------------------------------------------
# 2. TextBEE Live SMS Emergency Gateway
# ------------------------------------------------------------------------------
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=txb_your_api_key_here
TEXTBEE_DEVICE_ID=your_device_id_here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
DEFAULT_EMERGENCY_RECIPIENT=9489240892

# ------------------------------------------------------------------------------
# 3. Whisper ASR & Audio Settings
# ------------------------------------------------------------------------------
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo
WHISPER_DEVICE=auto
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_API_KEY=your_huggingface_token_here
MAPTILER_API_KEY=your_maptiler_key_here

# ------------------------------------------------------------------------------
# 4. Server & Security Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=*
