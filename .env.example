# NIRA Environment Configuration Example
# Amazon Developer Hackathon 2026

# Environment & Server
ENVIRONMENT=development
DEBUG=false
APP_NAME=NIRA Ambient Care System
APP_VERSION=2.0.0
HOST=0.0.0.0
PORT=8000

# Voice Agent & Latency SLA (sub-500ms voice guarantee)
LATENCY_BUDGET_MS=500.0
WELLNESS_CHECK_TIMEOUT_SECONDS=20

# Resident Profile
DEFAULT_PATIENT_ID=PT-84920
DEFAULT_PATIENT_NAME=Eleanor Vance
DEFAULT_LOCATION_LABEL=Residence Unit 4B - Beacon Hill

# Primary Caregiver / Guardian Configuration
PRIMARY_CAREGIVER_NAME=David Vance (Son & Guardian)
PRIMARY_CAREGIVER_PHONE=+1-555-019-2834
PRIMARY_CAREGIVER_DEVICE_ID=alexa_device_echo_show_15_david

# Simulated External Adapters
EMS_DISPATCH_ENDPOINT=https://mock-cad.emergency-services.internal/v1/dispatch
EMS_DISPATCH_TIMEOUT_SEC=0.250
SMS_PROVIDER=simulated
ALEXA_PROVIDER=simulated
SMART_LOCK_PROVIDER=simulated

# Database Connection (Default: local SQLite database)
DATABASE_URL=sqlite:///./aegis_care.db

# CORS Configuration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
