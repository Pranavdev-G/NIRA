{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NIRA Authoritative Risk Assessment Contract",
  "description": "Standardized output of the multimodal risk engine in NIRA Live.",
  "type": "object",
  "required": [
    "assessment_id",
    "timestamp",
    "resident_id",
    "risk_level",
    "overall_score",
    "confidence",
    "contributing_signals",
    "context_modifiers",
    "baseline_tolerance_sec",
    "recommended_action"
  ],
  "properties": {
    "assessment_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "resident_id": { "type": "string" },
    "risk_level": {
      "type": "string",
      "enum": ["NORMAL", "LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "overall_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Composite multimodal risk score between 0.0 (safe) and 1.0 (immediate emergency)"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "contributing_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_name", "weight", "raw_value", "risk_contribution"],
        "properties": {
          "signal_name": { "type": "string" },
          "weight": { "type": "number" },
          "raw_value": {},
          "risk_contribution": { "type": "number" },
          "is_abnormal": { "type": "boolean" },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "context_modifiers": {
      "type": "object",
      "required": ["zone", "zone_risk_tier", "circadian_phase", "hazard_multiplier"],
      "properties": {
        "zone": { "type": "string" },
        "zone_risk_tier": { "type": "string" },
        "circadian_phase": { "type": "string" },
        "hazard_multiplier": { "type": "number" }
      }
    },
    "baseline_tolerance_sec": {
      "type": "number",
      "description": "Learned dynamic tolerance for immobility in this zone/hour"
    },
    "recommended_action": {
      "type": "string",
      "enum": [
        "CONTINUE_MONITORING",
        "TRIGGER_WELLNESS_CHECK",
        "ESCALATE_CAREGIVER",
        "DISPATCH_EMERGENCY_CAD",
        "RESOLVE_INCIDENT"
      ]
    }
  },
  "additionalProperties": false
}
