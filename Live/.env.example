# NIRA Live Voice Interaction Configuration
# Amazon Developer Hackathon 2026

# Primary Whisper ASR Model
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo

# Hardware Acceleration ('auto', 'cuda', 'mps', or 'cpu')
# 'auto' automatically selects CUDA GPU if available, else MPS on Mac, else CPU.
WHISPER_DEVICE=auto

# Audio Capture Settings
MIC_SAMPLE_RATE=16000
MIC_DEVICE_INDEX=
MIC_MAX_RECORD_SECONDS=10.0
MIC_SILENCE_TIMEOUT_SECONDS=2.2
MIC_ENERGY_THRESHOLD=0.015

# Database Path / Connection
DATABASE_URL=sqlite:///./aegis_care.db

# Live Ingest Stream Backend URL
BACKEND_URL=http://localhost:8000

# Optional: LLM Semantic Response Evaluator (fallback to deterministic clinical engine if empty)
OPENAI_API_KEY=
